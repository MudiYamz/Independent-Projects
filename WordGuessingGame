import random

name = input("What is your name?: ")
print("Hello, " + name + ". Welcome to the Word Guessing Game!")

words = ["python", "java", "kotlin", "javascript", "ruby", "swift", "typescript", "go",
          "rust", "perl"]
word = random.choice(words)

print("I have selected a random programming language. Try to guess it!")

guesses = ""
turns = 10

while turns > 0:
    failed = 0
    for char in word:
        if char in guesses:
            print(char, end=" ")
        else:
            print("_", end=" ")
            failed += 1

    if failed == 0:
        print("\nCongratulations! You guessed the word:", word)
        break

    guess = input("\nGuess a programming language: ")
    guesses += guess

    if guess not in word:
        turns -= 1
        print("Wrong guess. You have", turns, "more guesses.")

        if turns == 0:
            print("Sorry, you ran out of guesses. The word was:", word)